# URL pubblico del sito (usato per metadata, sitemap, Open Graph). Segnaposto: cultivarolio.it
NEXT_PUBLIC_SITE_URL=https://cultivarolio.it

# --- WordPress headless -------------------------------------------------------------------
# Base della REST API di WordPress. Segnaposto: wp.cultivarolio.it. Se manca, il sito usa il mock e i testi di riserva.
NEXT_PUBLIC_WP_API_URL=https://wp.cultivarolio.it/wp-json/wp/v2
# (opzionale) CMS_PROVIDER=mock|wordpress forza la sorgente; di default è wordpress se NEXT_PUBLIC_WP_API_URL è impostato

# Token del webhook /api/revalidate: lo stesso valore va in wp-config.php come WP_REVALIDATE_TOKEN
WP_REVALIDATE_TOKEN=
# Segreto di /api/preview: lo stesso valore va in wp-config.php come WP_PREVIEW_SECRET
WP_PREVIEW_SECRET=
# Anteprima delle bozze: utente WordPress dedicato con ruolo Editor + Application Password.
# Solo lato server: MAI con prefisso NEXT_PUBLIC_
WP_PREVIEW_USER=
WP_PREVIEW_APP_PASSWORD=

# --- Modulo contatti (Resend) -------------------------------------------------------------
# Destinatario dei messaggi
CONTATTI_DESTINATARIO=info@cultivarolio.it
# Chiave API di Resend
EMAIL_API_KEY=
# Mittente su un dominio verificato in Resend, es. "Cultivar <sito@cultivarolio.it>"
EMAIL_FROM=

# Sito in costruzione: attivo finché questa riga è assente. Per pubblicare il sito vero: SITO_PUBBLICO=1 (poi nuovo deploy)
# SITO_PUBBLICO=1

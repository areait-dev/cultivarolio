# URL pubblico del sito (usato per metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.cultivarolio.it

# Sorgente dei contenuti: "mock" finché il CMS non è collegato
CMS_PROVIDER=mock
# Esempi per il CMS scelto (da compilare quando si collega l'adattatore)
# CMS_API_URL=
# CMS_API_TOKEN=

# Destinatario del modulo contatti
CONTATTI_DESTINATARIO=comunicazione@promotergroup.eu
# Chiave del servizio email transazionale (es. Resend, Postmark, SMTP relay)
# EMAIL_API_KEY=

# Sito in costruzione: attivo finché questa riga è assente. Per pubblicare il sito vero: SITO_PUBBLICO=1 (poi nuovo deploy)
# SITO_PUBBLICO=1
